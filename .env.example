# ==============================================================================
# ANDHAK EDR — Environment Configuration Template
# Copy to .env for local development. Never commit .env or real secrets.
# ==============================================================================

# --- Runtime & Network Binding ---
ANDHAK_EDR_ENV=development
ANDHAK_EDR_HOST=127.0.0.1
ANDHAK_EDR_PORT=8010
ANDHAK_EDR_CORS_ORIGINS=["http://127.0.0.1:5174","http://localhost:5174","http://127.0.0.1:5173"]
ANDHAK_DEMO_MODE=false

# --- Storage (Local-First SQLite Primary; Optional PostgreSQL/Redis) ---
# Default uses a local SQLite database with WAL mode enabled.
ANDHAK_EDR_DATA_DIR=.local-data
ANDHAK_EDR_DB_URL=sqlite+aiosqlite:///./.local-data/andhak-edr.sqlite3
# Optional PostgreSQL production target (requires asyncpg/psycopg):
# ANDHAK_EDR_DB_URL=postgresql+asyncpg://andhak:change-me@127.0.0.1:5432/andhak_edr
# Optional Redis pub/sub bus (when unset, uses built-in asyncio event bus):
# ANDHAK_EDR_REDIS_URL=redis://127.0.0.1:6379/0

# --- Authentication & Enrollment ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ANDHAK_EDR_JWT_SECRET=CHANGE_ME_LOCAL_DEV_ONLY_MIN_32_CHARS
ANDHAK_EDR_JWT_EXPIRE_MINUTES=480
ANDHAK_EDR_ENROLLMENT_BOOTSTRAP_TOKEN=CHANGE_ME_ONE_TIME_BOOTSTRAP_TOKEN

# --- Storage Retention Policies (days) ---
ANDHAK_RETENTION_TELEMETRY_DAYS=30
ANDHAK_RETENTION_ALERTS_DAYS=90
ANDHAK_RETENTION_INCIDENTS_DAYS=180
ANDHAK_RETENTION_AUDIT_DAYS=365

# --- Threat Intelligence Policy Gates (All external lookups disabled by default) ---
ANDHAK_INTEL_EXTERNAL_ENABLED=false
ANDHAK_INTEL_ALLOW_HASH_ONLY=true
ANDHAK_INTEL_ALLOW_FILE_UPLOAD=false
# MALWAREBAZAAR_AUTH_KEY=
# ABUSEIPDB_API_KEY=
# VIRUSTOTAL_API_KEY=

# --- ANDHAK SOC Integration Bridge ---
ANDHAK_SOC_ENABLED=true
ANDHAK_SOC_BASE_URL=http://127.0.0.1:8000
ANDHAK_SOC_BRIDGE_SHARED_SECRET=CHANGE_ME_SOC_BRIDGE_HMAC_SECRET
ANDHAK_SOC_SYNC_INTERVAL_SECONDS=15

# --- Rust Agent Configuration Defaults ---
ANDHAK_AGENT_BACKEND_URL=https://127.0.0.1:8010
ANDHAK_AGENT_BATCH_SIZE=100
ANDHAK_AGENT_FLUSH_INTERVAL_MS=2000
ANDHAK_AGENT_HEARTBEAT_SECONDS=15
